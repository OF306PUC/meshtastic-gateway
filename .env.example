# Copy to .env next to docker-compose.yaml; never committed (G9).
# Docker Compose reads it for ${VAR} interpolation; the gateway reads it from
# its environment. Settings that describe the mesh live in deployments/.
# Credentials do NOT go here: mqtt/init-credentials.sh writes them to
# secrets/<service>.env, together with mqtt/pwfile (G5).

# ── Required: nothing defaults to a mesh, a namespace or a radio ─────────────

# The file in deployments/ (without .yaml) that describes the mesh.
MESH_DEPLOYMENT=

# Topics are <prefix>/<node_label>/<kind>. No default: two deployments under
# one prefix interleave silently. Letters, digits, '.', '_' and '-' only.
# Telegraf and the broker ACL read this same variable when their containers
# start (G4): after changing it, `docker compose up -d --force-recreate`.
MQTT_TOPIC_PREFIX=

# The gateway radio's serial device. Prefer /dev/serial/by-id/...: ttyACM
# numbers change between boots.
GATEWAY_SERIAL_PORT=

# The InfluxDB database: created on influxdb's first start, written by
# Telegraf, read by the dashboard and tools/plot_history.py.
INFLUXDB_DB=cpsrtc_meshtastic_telemetry

# ── Optional ─────────────────────────────────────────────────────────────────

# BROKER_ADDRESS=localhost             # "mosquitto" inside compose
# BROKER_PORT=1883
# CLIENT_ID=<prefix>-gateway           # unique per broker, or clients knock each other off

# Dashboard: the proxy's port on the network (the only one open), and extra
# origins for the live feed. Unset, the feed accepts the page's own origin,
# whatever name the browser used; list others only to embed it elsewhere.
# DASHBOARD_PORT=80
# MONITOR_ALLOWED_ORIGINS=http://other-site:8080

# PDR (docs/architecture/pdr-cadence-tracker.md §7)
# PDR_WINDOW_SEC=3600                  # rolling window, every flow: how much past is measured
# PDR_WINDOW_SEC_POSITION=21600        # per-flow override (_DEVICE, _ENVIRONMENT, _POSITION)
# PDR_SWEEP_INTERVAL_SEC=30            # how often silence is checked; below the shortest cadence
